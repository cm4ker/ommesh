<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS bundle's Info.plist by the Tauri CLI. Without the
     Bluetooth line macOS ends the app the moment it starts looking for a radio;
     the Russian wording is in macos/ru.lproj, as in the iPhone app. -->
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Ommesh talks to your MeshCore radio over Bluetooth.</string>
</dict>
</plist>
