{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ommesh",
  "version": "../../../package.json",
  "identifier": "dev.cm4ker.meshnet",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --filter @meshnet/meshcore build && pnpm --filter @meshnet/web dev",
    "beforeBuildCommand": "pnpm --filter @meshnet/meshcore build && pnpm --filter @meshnet/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ommesh",
        "label": "main",
        "width": 1080,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNzc2OTkxMEM4QjBGRkQKUldUOUQ0c01rV2wzajA4Z3VLSjBqR3FJeStmRU5IczhSeHgzUElzZUUza1JtRFBFOU0yYStpUEsK",
      "endpoints": ["https://github.com/cm4ker/ommesh/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "publisher": "Ommesh",
    "shortDescription": "A MeshCore companion",
    "longDescription": "Chat over a MeshCore LoRa mesh through a radio on Bluetooth, USB or Wi-Fi.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": { "Resources/ru.lproj/InfoPlist.strings": "macos/ru.lproj/InfoPlist.strings" }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
