{
  "name": "@meshnet/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//": "The client. One build serves three homes: a browser tab (Web Bluetooth and Web Serial, so Chrome or Edge), the Tauri desktop shell (its BLE and serial plugins), and the Capacitor phone shell (its BLE plugin). Which link it uses is decided at runtime in src/transports.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@meshnet/meshcore": "workspace:*",
    "@mnlphlp/plugin-blec": "^0.12.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "capacitor-secure-storage-plugin": "0.13.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tauri-plugin-serialplugin-api": "^3.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
