{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Radio connections, system links, starting at login, installation of signed desktop updates, and the buttons and dragging of the title bar the page draws. Update feeds are chosen by the native shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "blec:default",
    "serialplugin:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "ms-settings:notifications" }]
    },
    "updater:allow-download",
    "updater:allow-install",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
